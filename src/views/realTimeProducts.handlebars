<section>
  <h1>Productos en tiempo real</h1>
  <ul id="rt-products" class="product-list">
    {{#each products}}
      <li data-id="{{this.id}}" class="product-item">
        <strong>{{this.title}}</strong>
        — ${{this.price}}
        — Stock:
        {{this.stock}}
        <div class="muted">ID:
          {{this.id}}
          | Code:
          {{this.code}}
          | Cat:
          {{this.category}}</div>
      </li>
    {{/each}}
  </ul>
  <hr />
  <h2>Crear producto (WebSocket)</h2>
  <form id="create-form" class="form">
    <input name="title" placeholder="title" required />
    <input name="description" placeholder="description" required />
    <input name="code" placeholder="code" required />
    <input
      name="price"
      type="number"
      step="0.01"
      placeholder="price"
      required
    />
    <select name="status">
      <option value="true" selected>Activo</option>
      <option value="false">Inactivo</option>
    </select>
    <input
      name="stock"
      type="number"
      step="1"
      min="0"
      placeholder="stock"
      required
    />
    <input name="category" placeholder="category" required />
    <input name="thumbnails" placeholder="thumbnails (coma separadas)" />
    <button type="submit">Crear</button>
  </form>
  <h2>Eliminar producto (WebSocket)</h2>
  <form id="delete-form" class="form">
    <input name="id" placeholder="product id" required />
    <button type="submit">Eliminar</button>
  </form>
</section>
<script src="/socket.io/socket.io.js"></script>
<script src="/public/js/realtime.js"></script>